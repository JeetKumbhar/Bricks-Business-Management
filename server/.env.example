# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000

# Browser origin(s) allowed to call the API. Comma-separate several. No trailing slash.
CLIENT_ORIGIN=http://localhost:5173

# Required. The database name goes before the "?". URL-encode special characters in the password.
# Atlas : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Local : mongodb://127.0.0.1:27017/brickpro_dev
MONGODB_URI=

# Not used yet (auth phase). Leave blank for now.
JWT_SECRET=
JWT_EXPIRES_IN=
