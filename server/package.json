{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "description": "BrickPro backend (Express API)",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "vitest run",
    "test:app": "vitest run tests/app.test.js",
    "test:core": "vitest run tests/db.test.js tests/env.test.js tests/money.test.js tests/dates.test.js tests/schema.test.js",
    "test:auth": "vitest run tests/auth.test.js tests/authCookie.test.js tests/user.model.test.js",
    "test:labour": "vitest run tests/labour.test.js",
    "test:attendance": "vitest run tests/attendance.test.js",
    "test:maapEntry": "vitest run tests/maapEntry.test.js",
    "test:productionEntry": "vitest run tests/productionEntry.test.js",
    "test:payment": "vitest run tests/payment.test.js",
    "test:salary": "vitest run tests/salary.test.js",
    "create-owner": "node scripts/createOwner.js",
    "sync-indexes": "node scripts/syncIndexes.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.7",
    "pdfkit": "^0.20.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
